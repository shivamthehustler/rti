# ==============================================================================
# FLASH RTI - MONOREPO ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (or web/.env and ai/.env) and populate with your values.
# NEVER commit .env or any file containing real API keys/credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Service (Server-side only)
# ------------------------------------------------------------------------------
# Primary and fallback Google Gemini API keys (from Google AI Studio / GCP)
# Multiple keys enable automated round-robin load distribution and high availability.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GOOGLE_API_KEY=your_google_api_key_here

# ------------------------------------------------------------------------------
# 2. Database Connection (Server-side only)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for user history, requests, and statutory datasets.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/flash_rti

# ------------------------------------------------------------------------------
# 3. Public Web URLs (Safe for Client & Server)
# ------------------------------------------------------------------------------
# Next.js public site base URL for metadata, SEO canonical URLs, and API endpoints
NEXT_PUBLIC_SITE_URL=https://rtionline.gov.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Optional Service Configurations
# ------------------------------------------------------------------------------
# WebSocket server port (if running standalone ws service)
WS_PORT=3001

# FastAPI backend port (if running AI microservice separately)
FASTAPI_PORT=8000
