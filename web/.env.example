# ==============================================================================
# FLASH RTI - WEB APPLICATION ENVIRONMENT TEMPLATE (Next.js)
# ==============================================================================
# Copy this file to .env.local or .env in the web/ directory.
# NEVER commit real secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Keys (Server-side Only)
# ------------------------------------------------------------------------------
# API keys for Gemini models (Gemini 2.5/3.5/3.6 Flash) used for RTI formatting & data synthesis.
# You can provide a single key or multiple keys for automated round-robin pooling.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GOOGLE_API_KEY=your_google_api_key_here

# ------------------------------------------------------------------------------
# 2. Database (Server-side Only)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for saving citizen RTI requests and history.
# If omitted, the application uses built-in in-memory stores and mock datasets.
DATABASE_URL=postgresql://postgres:password@localhost:5432/flash_rti

# ------------------------------------------------------------------------------
# 3. Public Web URLs (Client & Server Accessible)
# ------------------------------------------------------------------------------
# Base domain URL for SEO canonicals and internal API service resolution.
NEXT_PUBLIC_SITE_URL=https://rtionline.gov.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Standalone WebSocket Server (Optional)
# ------------------------------------------------------------------------------
WS_PORT=3001
